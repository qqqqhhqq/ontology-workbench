# 复制为 .env 后填入真实模型 API 与 Key（.env 已被 .gitignore 忽略）
# 优先级：页面单次覆盖 > 环境变量 / .env > config/llm.local.yaml

# 可选协议：openai_compatible | anthropic | gemini
LLM_PROVIDER=openai_compatible

# 接口地址（按所用厂商二选一或填自定义网关）
# OpenAI:     https://api.openai.com/v1
# DeepSeek:   https://api.deepseek.com/v1
# 通义千问:    https://dashscope.aliyuncs.com/compatible-mode/v1
# Anthropic:  https://api.anthropic.com
# Gemini:     https://generativelanguage.googleapis.com/v1beta
# 本地Ollama:  http://127.0.0.1:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# 模型名称（如 gpt-4o-mini / deepseek-chat / qwen-plus / claude-sonnet-4-20250514 / gemini-2.5-flash）
LLM_MODEL=gpt-4o-mini

# 预留 API Key（后续填入你的真实密钥）
LLM_API_KEY=

# 推理参数
LLM_TEMPERATURE=0.1
LLM_MAX_TURNS=8
LLM_TIMEOUT_SECONDS=60
